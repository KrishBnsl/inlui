# Browser-visible service URLs.
NEXT_PUBLIC_ML_URL=http://localhost:8082
NEXT_PUBLIC_RAG_URL=http://localhost:8081

# Local Compose host ports.
FRONTEND_PORT=3000
INFERENCE_PORT=8082
RAG_PORT=8081

# Optional: without a key the RAG service starts in an explicit degraded state.
GOOGLE_API_KEY=
RAG_LLM_MODEL=gemini-2.5-flash
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=1024
RAG_EMBED_MODEL=models/gemini-embedding-2
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_REQUEST_TIMEOUT_SECONDS=20
RAG_PROVIDER_TIMEOUT_SECONDS=12
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_INLINE_IMAGE_BYTES=5242880
RAG_MAX_ML_CONTEXT_CHARS=20000

# Reproducible inference defaults.
MC_N_SIMS=1000

# Used only with: docker compose --profile rust-sim up --build
RUST_SIM_POSTGRES_PASSWORD=inlui_local_only
RUST_SIM_PORT=8080
