# ─────────────────────────────────────────────────────────────────────────────
# Inference Service — Environment Configuration Template
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute (or repo-relative) path to the `models/` directory
MODELS_DIR=../models

# Absolute (or repo-relative) path to the data directory inside models/
DATA_DIR=../models/data

# Absolute (or repo-relative) path to saved artifact files
ARTIFACTS_DIR=../models/model_artifacts

# Monte Carlo simulation settings
MC_N_SIMS=1000
MC_STD_DEV_DEFAULT=150.0

# Server
PORT=8082

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
