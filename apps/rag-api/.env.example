# RAG Service — Environment Configuration Template
# Copy this file to .env and fill in local values before running.

GOOGLE_API_KEY=your_google_api_key_here
RAG_LLM_MODEL=gemini-2.5-flash
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=1024
RAG_EMBED_MODEL=models/gemini-embedding-2
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_INLINE_IMAGE_BYTES=5242880
RAG_REQUEST_TIMEOUT_SECONDS=20
RAG_PROVIDER_TIMEOUT_SECONDS=12
RAG_MAX_ML_CONTEXT_CHARS=20000
PORT=8081
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
