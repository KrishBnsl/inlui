# ─────────────────────────────────────────────────────────────────────────────
# Inference Service — Environment Configuration Template
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path, or a path relative to the process working directory.
RESEARCH_DIR=../../research

# Local research data (provenance-gated and normally ignored by Git).
DATA_DIR=../../research/data

# Absolute (or repo-relative) path to saved artifact files
ARTIFACTS_DIR=../../research/artifacts

# Monte Carlo simulation settings
MC_N_SIMS=1000
MC_STD_DEV_DEFAULT=150.0

# Server
PORT=8082

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
